# ---------------------------------------------------------------------------
# VMotors · credenciales de PostgreSQL
# ---------------------------------------------------------------------------
# Copie este archivo como `.env` y ajuste los valores. El archivo `.env` NO
# debe subirse al repositorio: contiene la contraseña de la base de datos.
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

PGHOST=localhost
PGPORT=5432
PGDATABASE=vmotors
PGUSER=postgres
PGPASSWORD=

# Esquema donde se crearán las tablas (por omisión: vmotors)
VMOTORS_SCHEMA=vmotors

# Alternativa: una sola cadena de conexión. Si está definida, tiene prioridad
# sobre las variables anteriores.
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/vmotors
